# Copy this file to .env and adjust values as needed

# Port the backend server listens on
PORT=3002

# --- Local development (default): free local Ollama, no key needed ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Hosted deployment: set GROQ_API_KEY and Ollama is skipped automatically ---
# Get a free key at https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Allowed frontend origin for CORS (only matters if serving the frontend separately)
FRONTEND_URL=http://localhost:8080
